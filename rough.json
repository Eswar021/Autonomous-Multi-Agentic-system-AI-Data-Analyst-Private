{
    "title": "Monthly Sales Trend",
    "purpose": "Show the trend of sales over time.",
    "why": "Visualize sales performance by month to identify seasonality and growth trends.",
    "type": "line",
    "data_access": {
        "file_path": "data\\sales_data.csv",
        "file_abspath": "D:\\Autonomous_Dashboard_Creator_Agent\\data\\sales_data.csv"
    },
    "query": {
        "grain": "by MONTH & YEAR",
        "filters": [
            "YEAR_ID >= 2003"
        ],
        "aggregations": [{
            "name": "Total Sales",
            "expr": "SUM(SALES)"
        }],
        "groupby": [
            "YEAR_ID",
            "MONTH_ID"
        ],
        "sort": [{
                "by": "YEAR_ID",
                "order": "asc"
            },
            {
                "by": "MONTH_ID",
                "order": "asc"
            }
        ],
        "limit": null
    },
    "encodings": {
        "x": {
            "field": "MONTH_ID",
            "type": "temporal"
        },
        "y": {
            "field": "Total Sales",
            "type": "quantitative"
        },
        "color": {
            "field": "YEAR_ID",
            "type": "string",
            "legend": true
        },
        "facet": {
            "field": null,
            "type": "string"
        }
    },
    "columns_used": [{
            "name": "MONTH_ID",
            "dtype": "integer",
            "semantics": [
                "date_like",
                "id"
            ],
            "description": "The month in which the order was placed."
        },
        {
            "name": "SALES",
            "dtype": "float",
            "semantics": [
                "date_like",
                "money"
            ],
            "description": "The total sales amount for the specific product line in the order."
        },
        {
            "name": "YEAR_ID",
            "dtype": "integer",
            "semantics": [
                "date_like",
                "id"
            ],
            "description": "The year in which the order was placed."
        }
    ],
    "assumptions": [
        "Sales data is consistently recorded each month."
    ],
    "notes_for_codegen": "Ensure correct date formatting for x-axis."
